{
  "name": "@forgesworn/kindred",
  "version": "0.1.0",
  "description": "Verified relationships across three social distances — kin (family), kith (mutually verified), ken (one-way recognised) — with handshake, bond ceremony, ken trust-store, and local presence discovery.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./handshake": {
      "types": "./dist/handshake.d.ts",
      "default": "./dist/handshake.js"
    },
    "./bond": {
      "types": "./dist/bond.d.ts",
      "default": "./dist/bond.js"
    },
    "./ken": {
      "types": "./dist/ken.d.ts",
      "default": "./dist/ken.js"
    },
    "./discovery": {
      "types": "./dist/discovery.d.ts",
      "default": "./dist/discovery.js"
    },
    "./invite": {
      "types": "./dist/invite.d.ts",
      "default": "./dist/invite.js"
    }
  },
  "files": [
    "dist",
    "vectors",
    "LICENSE",
    "llms.txt",
    "README.md",
    "PROTOCOL.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "vectors:check": "node ./scripts/check-vectors.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nostr",
    "relationships",
    "verification",
    "ecdh",
    "spoken-token",
    "kith",
    "kin",
    "ken",
    "presence"
  ],
  "author": "forgesworn",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@forgesworn/tessera-kit": "git+https://github.com/forgesworn/tessera-kit.git#175ca6dad33666418716bf307784552a3eb0534d",
    "@noble/ciphers": "^2.0.0",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "nostr-attestations": "^2.5.5",
    "spoken-token": "^2.0.4"
  },
  "peerDependencies": {
    "nostr-tools": "^2.0.0"
  },
  "devDependencies": {
    "@scure/base": "^2.0.0",
    "@types/node": "^22",
    "nostr-tools": "^2.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "provenance": true
  },
  "funding": {
    "type": "lightning",
    "url": "lightning:thedonkey@strike.me"
  },
  "homepage": "https://github.com/forgesworn/kindred#readme",
  "bugs": {
    "url": "https://github.com/forgesworn/kindred/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forgesworn/kindred.git"
  }
}
