{
  "name": "@forgesworn/kenspeckle",
  "version": "0.2.0",
  "description": "Verified relationships across three social distances — kin (family), kith (mutually verified), ken (one-way recognised) — with handshake, bond ceremony, ken trust-store, and local presence discovery.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./handshake": {
      "types": "./dist/handshake.d.ts",
      "default": "./dist/handshake.js"
    },
    "./bond": {
      "types": "./dist/bond.d.ts",
      "default": "./dist/bond.js"
    },
    "./ken": {
      "types": "./dist/ken.d.ts",
      "default": "./dist/ken.js"
    },
    "./discovery": {
      "types": "./dist/discovery.d.ts",
      "default": "./dist/discovery.js"
    },
    "./invite": {
      "types": "./dist/invite.d.ts",
      "default": "./dist/invite.js"
    },
    "./companion-rail": {
      "types": "./dist/companion-rail.d.ts",
      "default": "./dist/companion-rail.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "vectors",
    "LICENSE",
    "llms.txt",
    "README.md",
    "PROTOCOL.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "vectors:check": "node ./scripts/check-vectors.mjs",
    "check:publishable-deps": "node ./scripts/check-publishable-deps.mjs",
    "lint:package": "node ./scripts/lint-package.mjs",
    "prepare": "npm run build",
    "prepack": "npm run check:publishable-deps",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run vectors:check"
  },
  "keywords": [
    "nostr",
    "relationships",
    "verification",
    "ecdh",
    "spoken-token",
    "kith",
    "kin",
    "ken",
    "presence"
  ],
  "author": "forgesworn",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@forgesworn/tessera-kit": "git+https://github.com/forgesworn/tessera-kit.git#7ffded7b019b851f57bc1760b92cdda3f05a1b08",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.0.1",
    "nostr-attestations": "^3.0.0",
    "spoken-token": "^2.1.0"
  },
  "peerDependencies": {
    "nostr-tools": "^2.23.9"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@scure/base": "^2.4.0",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^5.0.1",
    "nostr-tools": "^2.24.1",
    "publint": "^0.3.24",
    "typescript": "^6.0.2",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "provenance": true
  },
  "funding": {
    "type": "lightning",
    "url": "lightning:profusemeat89@walletofsatoshi.com"
  },
  "homepage": "https://github.com/forgesworn/kenspeckle#readme",
  "bugs": {
    "url": "https://github.com/forgesworn/kenspeckle/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forgesworn/kenspeckle.git"
  }
}
